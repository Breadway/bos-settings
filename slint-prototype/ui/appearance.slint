import { Theme, PageTitle, Lede, GroupBox, SettingRow, Toggle, AccentSlider, SelectBox, ValueText, PillButton } from "theme.slint";

export struct ThemeCard {
    id: string,
    name: string,
    preview: string,
    sub: string,
}

export struct WallpaperThumb {
    name: string,
    path: string,
    image: image,
}

// A mini screen per theme: the bar where that theme actually puts it, at
// its own proportions, over the wallpaper wash. Derived from each
// theme.toml's [bar.window] (spotlight is a centred pill, liquid-motion a
// wide floating bar, glass-workbench flush, daylight a bottom dock, loaf a
// floating island). Custom themes inherit the look they `extends`.
component ThemePreview inherits Rectangle {
    in property <string> look;
    property <bool> light: look == "daylight";
    clip: true;
    border-radius: 8px;
    background: @linear-gradient(140deg, Theme.accent-soft 0%, Theme.bg 100%);

    if light: Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(140deg, #e8dccb 0%, #c9b8a0 100%);
    }

    // Bars, in screen order.
    if look == "spotlight": Rectangle {
        x: parent.width * 0.31;
        y: 5px;
        width: parent.width * 0.38;
        height: 10px;
        border-radius: 5px;
        background: #0a0c0ee6;
        border-width: 1px;
        border-color: #ffffff1a;
    }
    if look == "liquid-motion": Rectangle {
        x: 5px;
        y: 4px;
        width: parent.width - 10px;
        height: 11px;
        border-radius: 5px;
        background: #ffffff38;
    }
    if look == "glass-workbench": Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 7px;
        background: #ffffff2e;
        border-width: 1px;
        border-color: #ffffff4d;
    }
    if look == "daylight": Rectangle {
        x: 0;
        y: parent.height - 15px;
        width: 100%;
        height: 11px;
        background: #f2efe8;
    }
    if look == "loaf": Rectangle {
        x: parent.width * 0.09;
        y: 5px;
        width: parent.width * 0.82;
        height: 10px;
        border-radius: 5px;
        background: #d9a066;
    }
    if look == "strata": Rectangle {
        x: 0;
        y: 0;
        width: 11px;
        height: 100%;
        background: Theme.accent;
    }
    if look == "console": Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 9px;
        background: #0b0d0b;
    }
    if look == "kuro": Rectangle {
        x: 0;
        y: parent.height - 9px;
        width: 100%;
        height: 9px;
        background: #000000;
    }
    property <bool> known:
        look == "spotlight" || look == "liquid-motion" || look == "glass-workbench"
        || look == "daylight" || look == "loaf" || look == "strata"
        || look == "console" || look == "kuro";
    if !known: Rectangle {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: 8px;
        border-radius: 5px;
        background: Theme.accent;
    }

    Rectangle {
        x: 16px;
        y: 24px;
        width: parent.width - 32px;
        height: parent.height - 40px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.surface;
    }
}

// Slint's clip is rectangular, so a rounded Image keeps square corners.
// These four paths paint the corner cut-outs in the panel colour, which is
// what the surface behind every rounded image here is.
component CornerMask inherits Path {
    in property <int> corner: 0;
    in property <length> size: 8px;
    in property <brush> fill-color: Theme.surface;
    width: size;
    height: size;
    viewbox-width: 1;
    viewbox-height: 1;
    fill: fill-color;
    // The arc must bulge toward the corner itself (sweep flags below), or
    // the mask eats a disc out of the image instead of its corner.
    commands: corner == 0
        ? "M 0 0 L 1 0 A 1 1 0 0 0 0 1 Z"
        : (corner == 1
            ? "M 1 0 L 0 0 A 1 1 0 0 1 1 1 Z"
            : (corner == 2
                ? "M 0 1 L 1 1 A 1 1 0 0 1 0 0 Z"
                : "M 1 1 L 0 1 A 1 1 0 0 0 1 0 Z"));
}

component RoundedImage inherits Rectangle {
    in property <image> source;
    in property <length> radius: 8px;
    clip: true;
    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
    CornerMask { corner: 0; size: root.radius; x: 0; y: 0; }
    CornerMask { corner: 1; size: root.radius; x: parent.width - root.radius; y: 0; }
    CornerMask { corner: 2; size: root.radius; x: 0; y: parent.height - root.radius; }
    CornerMask { corner: 3; size: root.radius; x: parent.width - root.radius; y: parent.height - root.radius; }
}

export component AppearancePage inherits VerticalLayout {
    in property <length> content-width: 716px;
    in-out property <float> gaps-in;
    in-out property <float> gaps-out;
    in-out property <float> border-size;
    in-out property <color> active-border;
    in-out property <float> active-border-alpha;
    in-out property <color> inactive-border;
    in-out property <float> inactive-border-alpha;
    in-out property <float> rounding;
    in-out property <bool> blur;
    in-out property <float> blur-size;
    in-out property <float> blur-passes;
    in-out property <bool> shadows;
    in-out property <float> shadow-range;
    in-out property <bool> resize-on-border;
    in-out property <int> layout-index;
    in-out property <string> status;
    in property <[ThemeCard]> themes;
    in-out property <string> active-theme;
    in property <image> wallpaper;
    in property <string> wallpaper-name;
    in property <string> wallpaper-path;
    in property <string> library-dir;
    in property <[WallpaperThumb]> library;
    in-out property <int> text-size-index;
    in-out property <int> font-index;
    callback changed();
    callback theme-selected(string);
    callback wallpaper-selected(string);
    callback choose-wallpaper();
    callback restart-shell();
    callback text-changed();
    // repeat(auto-fill, minmax(200px, 1fr)): equal columns, whatever the
    // longest theme name is.
    property <int> theme-cols: max(1, Math.floor((root.content-width / 1px - 34 + 8) / 208));
    property <length> theme-card-width: (root.content-width - 34px - (theme-cols - 1) * 8px) / theme-cols;
    spacing: 0px;
    alignment: start;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text { text: "Personalise"; font-family: Theme.body; color: Theme.faint; font-size: 12px; }
        Text { text: "›"; font-family: Theme.body; color: Theme.faint; font-size: 12px; }
        Text { text: "Appearance"; font-family: Theme.body; color: Theme.muted; font-size: 12px; }
    }
    Rectangle { height: 8px; }
    PageTitle { text: "Appearance"; }
    Rectangle { height: 6px; }
    Lede { text: "Wallpaper sets the colors. Windows follow."; }
    Rectangle { height: 18px; }

    GroupBox {
        title: "THEME";
        GridLayout {
            spacing: 8px;
            for card[index] in root.themes: Rectangle {
                row: Math.floor(index / root.theme-cols);
                col: Math.mod(index, root.theme-cols);
                width: root.theme-card-width;
                height: 143px;
                border-radius: 10px;
                background: Theme.bg;
                border-width: 2px;
                border-color: card.id == root.active-theme ? Theme.accent : transparent;
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;
                    alignment: start;
                    ThemePreview {
                        height: 72px;
                        look: card.preview;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        spacing: 0px;
                        horizontal-stretch: 1;
                        Text {
                            text: card.name;
                            height: 20px;
                            font-family: Theme.body;
                            color: Theme.fg;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        Text {
                            text: card.sub;
                            height: 13px;
                            font-family: Theme.body;
                            color: Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }
                }
                TouchArea {
                    clicked => { root.theme-selected(card.id); }
                }
            }
        }
        Rectangle { height: 12px; }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            PillButton {
                text: "Restart bar and launcher";
                ghost: true;
                clicked => { root.restart-shell(); }
            }
        }
    }

    Rectangle { height: 14px; }

    GroupBox {
        title: "WALLPAPER";
        hint: "This also sets the desktop colors: each monitor's accent comes from its own wallpaper.";
        if root.wallpaper-name != "": Rectangle {
            height: 180px;
            border-radius: 12px;
            clip: true;
            background: transparent;
            RoundedImage {
                source: root.wallpaper;
                radius: 12px;
                width: 100%;
                height: 100%;
            }
            Rectangle {
                x: 12px;
                y: parent.height - 34px;
                width: caption.width + 16px;
                height: 24px;
                border-radius: 6px;
                background: #00000066;
                caption := Text {
                    x: 8px;
                    y: 0;
                    height: 100%;
                    text: root.wallpaper-name;
                    font-family: Theme.body;
                    color: #ffffffcc;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        if root.wallpaper-name == "": Rectangle {
            height: 180px;
            border-radius: 12px;
            background: Theme.bg;
            Text {
                text: "No wallpaper";
                font-family: Theme.body;
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 12px; }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            PillButton {
                text: "Choose image";
                primary: true;
                clicked => { root.choose-wallpaper(); }
            }
        }
    }

    Rectangle { height: 14px; }

    GroupBox {
        title: "LIBRARY";
        GridLayout {
            spacing: 8px;
            property <int> cols: max(1, Math.floor((root.content-width / 1px + 8) / 128));
            for thumb[index] in root.library: Rectangle {
                row: Math.floor(index / cols);
                col: Math.mod(index, cols);
                height: 81px;
                border-radius: 8px;
                border-width: 2px;
                border-color: thumb.path == root.wallpaper-path ? Theme.accent : transparent;
                clip: true;
                RoundedImage {
                    source: thumb.image;
                    radius: 6px;
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                }
                TouchArea {
                    clicked => { root.wallpaper-selected(thumb.path); }
                }
            }
        }
        if root.library.length == 0: Text {
            text: "Nothing in " + root.library-dir;
            font-family: Theme.body;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: left;
        }
    }

    Rectangle { height: 14px; }

    GroupBox {
        title: "WINDOWS";
        Rectangle {
            // --gi/--go/--r/--bw: the shipping preview scales the values by
            // 0.6 and keeps a 2px seam so the panes never merge into a blank.
            height: 118px;
            border-radius: 12px;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;
            property <length> gap: max(2px, gaps-in * 0.6px);
            property <length> edge: gaps-out * 0.6px;
            property <length> radius: rounding * 1px;
            property <length> border: max(1px, border-size * 1px);
            property <brush> border-tint: border-size > 0 ? Theme.accent : Theme.line;
            HorizontalLayout {
                padding: edge;
                spacing: gap;
                Rectangle {
                    horizontal-stretch: 1.3;
                    border-radius: radius;
                    background: Theme.surface-2;
                    border-width: border;
                    border-color: border-tint;
                }
                VerticalLayout {
                    spacing: gap;
                    horizontal-stretch: 1;
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: radius;
                        background: Theme.surface-2-soft;
                        border-width: border;
                        border-color: border-tint;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: radius;
                        background: Theme.surface-2;
                        border-width: border;
                        border-color: border-tint;
                    }
                }
            }
        }
        SettingRow { label: "Gaps between windows"; first: true;
            AccentSlider { minimum: 0; maximum: 50; value <=> gaps-in; changed(_) => { root.changed(); } }
            ValueText { text: round(gaps-in); }
        }
        SettingRow { label: "Gaps around the edge";
            AccentSlider { minimum: 0; maximum: 50; value <=> gaps-out; changed(_) => { root.changed(); } }
            ValueText { text: round(gaps-out); }
        }
        SettingRow { label: "Border width";
            AccentSlider { minimum: 0; maximum: 10; value <=> border-size; changed(_) => { root.changed(); } }
            ValueText { text: round(border-size); }
        }
        SettingRow { label: "Active border";
            Rectangle {
                width: 36px;
                height: 26px;
                border-radius: 4px;
                background: root.active-border;
                border-width: 1px;
                border-color: Theme.fg.with-alpha(20%);
            }
            AccentSlider {
                width: 100px;
                minimum: 0;
                maximum: 255;
                value <=> active-border-alpha;
                changed(_) => { root.changed(); }
            }
        }
        SettingRow { label: "Inactive border";
            Rectangle {
                width: 36px;
                height: 26px;
                border-radius: 4px;
                background: root.inactive-border;
                border-width: 1px;
                border-color: Theme.fg.with-alpha(20%);
            }
            AccentSlider {
                width: 100px;
                minimum: 0;
                maximum: 255;
                value <=> inactive-border-alpha;
                changed(_) => { root.changed(); }
            }
        }
        SettingRow { label: "Layout";
            SelectBox {
                text: layout-index == 0 ? "Tiling" : "Master stack";
                clicked => {
                    layout-index = layout-index == 0 ? 1 : 0;
                    root.changed();
                }
            }
        }
        SettingRow { label: "Resize by dragging the border";
            Toggle { checked <=> resize-on-border; toggled(_) => { root.changed(); } }
        }
    }

    Rectangle { height: 14px; }

    GroupBox {
        title: "EFFECTS";
        SettingRow { label: "Corner rounding"; first: true;
            AccentSlider { minimum: 0; maximum: 30; value <=> rounding; changed(_) => { root.changed(); } }
            ValueText { text: round(rounding); }
        }
        SettingRow { label: "Blur";
            Toggle { checked <=> blur; toggled(_) => { root.changed(); } }
        }
        if blur: SettingRow { label: "Blur size";
            AccentSlider { minimum: 0; maximum: 20; value <=> blur-size; changed(_) => { root.changed(); } }
            ValueText { text: round(blur-size); }
        }
        if blur: SettingRow { label: "Blur quality";
            AccentSlider { minimum: 1; maximum: 5; value <=> blur-passes; changed(_) => { root.changed(); } }
            ValueText { text: round(blur-passes); }
        }
        SettingRow { label: "Shadows";
            Toggle { checked <=> shadows; toggled(_) => { root.changed(); } }
        }
        if shadows: SettingRow { label: "Shadow size";
            AccentSlider { minimum: 0; maximum: 40; value <=> shadow-range; changed(_) => { root.changed(); } }
            ValueText { text: round(shadow-range); }
        }
    }

    Rectangle { height: 14px; }

    GroupBox {
        title: "TEXT";
        hint: "Settings, GTK apps and the bar. Other apps may use their own font settings.";
        SettingRow { label: "Text size"; first: true;
            SelectBox {
                width: 132px;
                text: ["Small", "Default", "Large", "Larger"][root.text-size-index];
                clicked => {
                    root.text-size-index = Math.mod(root.text-size-index + 1, 4);
                    root.text-changed();
                }
            }
        }
        SettingRow { label: "Font";
            SelectBox {
                width: 132px;
                text: ["Varela Round", "Inter", "Noto Sans"][root.font-index];
                clicked => {
                    root.font-index = Math.mod(root.font-index + 1, 3);
                    root.text-changed();
                }
            }
        }
    }

    if status != "": Text {
        text: status;
        font-family: Theme.body;
        color: Theme.red;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: left;
    }
}
