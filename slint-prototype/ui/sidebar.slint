import { Theme, VectorIcon } from "theme.slint";

export struct NavItem {
    id: string,
    label: string,
    section: string,
    // SVG path commands for the glyph, from src/icons.rs.
    icon: string,
    badge: string,
    live: bool,
}

export component Sidebar inherits Rectangle {
    in property <[NavItem]> items;
    in-out property <string> current: "home";
    in property <string> account-name: "User";
    in property <string> account-initial: "U";
    in property <string> account-host: "Bread OS";
    in property <string> search-icon;
    callback selected(string);
    width: 236px;
    background: Theme.bg-2;
    VerticalLayout {
        Rectangle {
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 14px;
                padding-bottom: 10px;
                Rectangle {
                    height: 42px;
                    border-radius: 10px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.line;
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        spacing: 9px;
                        alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            VectorIcon {
                                icon-size: 17px;
                                commands: root.search-icon;
                                tint: Theme.muted;
                            }
                        }
                        Text {
                            text: "Search settings";
                            font-family: Theme.body;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 5px;
                            height: 22px;
                            horizontal-stretch: 0;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                alignment: center;
                                Text {
                                    // The browser styles <kbd> with the
                                    // monospace font, and the shipping search
                                    // box inherits that.
                                    text: "Ctrl K";
                                    font-family: "DejaVu Sans Mono";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-bottom: 12px;
                spacing: 0px;
                alignment: start;
                for item in root.items: VerticalLayout {
                    spacing: 0px;
                    if item.section != "": Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-top: 14px;
                            alignment: start;
                            Text {
                                text: item.section;
                                font-family: Theme.body;
                                color: Theme.faint;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 1.2px;
                            }
                        }
                    }
                    Rectangle {
                        height: 31px;
                        border-radius: 9px;
                        background: item.id == root.current ? Theme.accent-soft : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 11px;
                            VerticalLayout {
                                horizontal-stretch: 0;
                                vertical-stretch: 1;
                                alignment: center;
                                VectorIcon {
                                    icon-size: 17px;
                                    commands: item.icon;
                                    tint: item.id == root.current ? Theme.accent : Theme.fg;
                                }
                            }
                            Rectangle {
                                // Stretch the label so a badge stays pinned right,
                                // the way the shipping sidebar does.
                                horizontal-stretch: 1;
                                Text {
                                    text: item.label;
                                    width: 100%;
                                    font-family: Theme.body;
                                    color: Theme.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if item.badge != "": VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Rectangle {
                                border-radius: item.badge == "NEW" ? 4px : 9px;
                                background: item.badge == "NEW" ? transparent : Theme.accent;
                                border-width: item.badge == "NEW" ? 1px : 0px;
                                border-color: Theme.accent-soft;
                                height: item.badge == "NEW" ? 14px : 16px;
                                horizontal-stretch: 0;
                                HorizontalLayout {
                                    padding-left: item.badge == "NEW" ? 3px : 4px;
                                    padding-right: item.badge == "NEW" ? 3px : 4px;
                                    alignment: center;
                                    Text {
                                        text: item.badge;
                                        font-family: Theme.body;
                                        font-size: item.badge == "NEW" ? 8px : 9px;
                                        font-weight: 600;
                                        letter-spacing: item.badge == "NEW" ? 0.5px : 0px;
                                        color: item.badge == "NEW" ? Theme.accent : Theme.on-accent;
                                        vertical-alignment: center;
                                    }
                                }
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.current = item.id;
                                root.selected(item.id);
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 55px;
            Rectangle { y: 0; height: 1px; width: 100%; background: Theme.line; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        horizontal-stretch: 0;
                        border-radius: 14px;
                        background: Theme.accent-soft;
                        Text {
                            text: root.account-initial;
                            font-family: Theme.body;
                            color: Theme.accent;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.account-name;
                        font-family: Theme.body;
                        color: Theme.fg;
                        font-size: 12.5px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    Text {
                        text: root.account-host;
                        font-family: Theme.body;
                        color: Theme.muted;
                        font-size: 11px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
