import { Theme } from "theme.slint";
import { Sidebar, NavItem } from "sidebar.slint";
import { HomePage, QuickTile, AttentionRow } from "home.slint";
import { AppearancePage, ThemeCard, WallpaperThumb } from "appearance.slint";

export { Theme, NavItem, QuickTile, AttentionRow, ThemeCard, WallpaperThumb }

export component AppWindow inherits Window {
    title: "BOS Settings";
    // The initial size is set from main.rs; binding a preferred size here
    // would make the layout width feed back into `self.width`.
    min-width: 860px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: "Varela Round";
    default-font-size: 13.5px;
    icon: @image-url("../../src/icons/128x128.png");
    in-out property <string> page: "home";

    // Responsive widths, set from main.rs (a binding to self.width would put
    // the layout and the window size in a dependency cycle).
    in-out property <length> sidebar-width: 236px;
    in-out property <length> content-width: 716px;
    in-out property <bool> rail: false;

    in property <[NavItem]> nav-items;
    in property <string> account-name;
    in property <string> account-initial;
    in property <string> account-host;
    in property <string> search-icon;

    in property <string> greeting;
    in property <string> lede;
    in property <[QuickTile]> tiles;
    in property <[AttentionRow]> attention;
    in property <string> battery-label;
    in property <string> battery-detail;
    in property <string> battery-arc;
    in property <string> storage-detail;
    in property <float> storage-used;
    in property <string> home-status;

    in-out property <float> gaps-in;
    in-out property <float> gaps-out;
    in-out property <float> border-size;
    in-out property <color> active-border;
    in-out property <float> active-border-alpha;
    in-out property <color> inactive-border;
    in-out property <float> inactive-border-alpha;
    in-out property <float> rounding;
    in-out property <bool> blur;
    in-out property <float> blur-size;
    in-out property <float> blur-passes;
    in-out property <bool> shadows;
    in-out property <float> shadow-range;
    in-out property <bool> resize-on-border;
    in-out property <int> layout-index;
    in-out property <string> appearance-status;
    in property <[ThemeCard]> themes;
    in-out property <string> active-theme;
    in property <image> wallpaper;
    in property <string> wallpaper-name;
    in property <string> wallpaper-path;
    in property <string> library-dir;
    in property <[WallpaperThumb]> library;
    in-out property <int> text-size-index;
    in-out property <int> font-index;

    callback tile-clicked(string);
    callback appearance-changed();
    callback theme-selected(string);
    callback wallpaper-selected(string);
    callback choose-wallpaper();
    callback restart-shell();
    callback text-changed();

    HorizontalLayout {
        Sidebar {
            width: root.sidebar-width;
            rail: root.rail;
            items: nav-items;
            current <=> page;
            account-name: account-name;
            account-initial: account-initial;
            account-host: account-host;
            search-icon: search-icon;
        }
        Rectangle { width: 1px; background: Theme.line; }
        scroller := Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;
            clip: true;
            // Wheel scrolling by hand: the winit backend turns a wheel notch
            // into 15-60px depending on the compositor, which feels slow next
            // to a webview. Multiply it and apply it immediately.
            property <length> scroll: 0px;
            property <length> content-height: content-page.height;
            property <length> max-scroll: max(0px, content-page.height - self.height);
            TouchArea {
                scroll-event(event) => {
                    if (event.delta-y == 0) {
                        return EventResult.reject;
                    }
                    scroller.scroll = min(
                        scroller.max-scroll,
                        max(0px, scroller.scroll - event.delta-y * 2.5)
                    );
                    return EventResult.accept;
                }
                content-page := VerticalLayout {
                    y: -scroller.scroll;
                    width: parent.width;
                    alignment: start;
                    HorizontalLayout {
                        padding-top: 23px;
                        padding-bottom: 48px;
                        Rectangle { horizontal-stretch: 1; min-width: 32px; }
                        VerticalLayout {
                            width: root.content-width;
                            spacing: 0px;
                            alignment: start;
                            if page == "home": HomePage {
                                greeting: greeting;
                                lede: lede;
                                content-width: root.content-width;
                                tiles: tiles;
                                attention: attention;
                                battery-label: battery-label;
                                battery-detail: battery-detail;
                                battery-arc: battery-arc;
                                storage-detail: storage-detail;
                                storage-used: storage-used;
                                status: home-status;
                                tile-clicked(id) => { root.tile-clicked(id); }
                            }
                            if page == "appearance": AppearancePage {
                                gaps-in <=> gaps-in;
                                gaps-out <=> gaps-out;
                                border-size <=> border-size;
                                active-border <=> active-border;
                                active-border-alpha <=> active-border-alpha;
                                inactive-border <=> inactive-border;
                                inactive-border-alpha <=> inactive-border-alpha;
                                rounding <=> rounding;
                                blur <=> blur;
                                blur-size <=> blur-size;
                                blur-passes <=> blur-passes;
                                shadows <=> shadows;
                                shadow-range <=> shadow-range;
                                resize-on-border <=> resize-on-border;
                                layout-index <=> layout-index;
                                status <=> appearance-status;
                                themes: root.themes;
                                active-theme <=> root.active-theme;
                                wallpaper: root.wallpaper;
                                wallpaper-name: root.wallpaper-name;
                                wallpaper-path: root.wallpaper-path;
                                library-dir: root.library-dir;
                                library: root.library;
                                text-size-index <=> root.text-size-index;
                                font-index <=> root.font-index;
                                changed => { root.appearance-changed(); }
                                theme-selected(id) => { root.theme-selected(id); }
                                wallpaper-selected(path) => { root.wallpaper-selected(path); }
                                choose-wallpaper => { root.choose-wallpaper(); }
                                restart-shell => { root.restart-shell(); }
                                text-changed => { root.text-changed(); }
                            }
                            if page != "home" && page != "appearance": VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Not in this prototype";
                                    font-family: Theme.display;
                                    color: Theme.fg;
                                    font-size: 26px;
                                    font-weight: 500;
                                }
                                Text {
                                    text: "Home and Appearance are the two wired pages. The rest of the sidebar is here so the shell matches; nothing on those pages writes settings.";
                                    font-family: Theme.body;
                                    color: Theme.muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; min-width: 32px; }
                    }
                }
            }
        }
    }
}
