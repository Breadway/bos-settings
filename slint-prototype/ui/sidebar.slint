import { Theme, VectorIcon } from "theme.slint";

export struct NavItem {
    id: string,
    label: string,
    section: string,
    // SVG path commands for the glyph, from src/icons.rs.
    icon: string,
    badge: string,
    live: bool,
}

export component Sidebar inherits Rectangle {
    in property <[NavItem]> items;
    in-out property <string> current: "home";
    in property <string> account-name: "User";
    in property <string> account-initial: "U";
    in property <string> account-host: "Bread OS";
    in property <string> search-icon;
    // Below 900px app.css collapses the sidebar to a 64px icon rail.
    in property <bool> rail: false;
    callback selected(string);
    width: 236px;
    background: Theme.bg-2;
    VerticalLayout {
        Rectangle {
            HorizontalLayout {
                padding-left: root.rail ? 8px : 12px;
                padding-right: root.rail ? 8px : 12px;
                padding-top: root.rail ? 12px : 14px;
                padding-bottom: root.rail ? 8px : 10px;
                Rectangle {
                    height: root.rail ? 39px : 42px;
                    border-radius: 10px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.line;
                    HorizontalLayout {
                        padding-left: root.rail ? 0px : 11px;
                        padding-right: root.rail ? 0px : 11px;
                        padding-top: root.rail ? 0px : 9px;
                        padding-bottom: root.rail ? 0px : 9px;
                        spacing: 9px;
                        alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            VectorIcon {
                                icon-size: 17px;
                                commands: root.search-icon;
                                tint: Theme.muted;
                            }
                        }
                        if !root.rail: Text {
                            text: "Search settings";
                            font-family: Theme.body;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if !root.rail: Rectangle {
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 5px;
                            height: 22px;
                            horizontal-stretch: 0;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                alignment: center;
                                Text {
                                    // The browser styles <kbd> with the
                                    // monospace font, and the shipping search
                                    // box inherits that.
                                    text: "Ctrl K";
                                    font-family: "DejaVu Sans Mono";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: root.rail ? 6px : 10px;
                padding-right: root.rail ? 6px : 10px;
                padding-bottom: 12px;
                spacing: 0px;
                alignment: start;
                for item in root.items: VerticalLayout {
                    spacing: 0px;
                    if item.section != "" && !root.rail: Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-top: 14px;
                            alignment: start;
                            Text {
                                text: item.section;
                                font-family: Theme.body;
                                color: Theme.faint;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 1.2px;
                            }
                        }
                    }
                    Rectangle {
                        height: root.rail ? 39px : 31px;
                        border-radius: 9px;
                        background: item.id == root.current ? Theme.accent-soft : transparent;
                        HorizontalLayout {
                            padding-left: root.rail ? 0px : 10px;
                            padding-right: root.rail ? 0px : 10px;
                            spacing: 11px;
                            alignment: root.rail ? center : start;
                            VerticalLayout {
                                horizontal-stretch: 0;
                                vertical-stretch: 1;
                                alignment: center;
                                VectorIcon {
                                    icon-size: 17px;
                                    commands: item.icon;
                                    tint: item.id == root.current ? Theme.accent : Theme.fg;
                                }
                            }
                            if !root.rail: Rectangle {
                                // Stretch the label so a badge stays pinned right,
                                // the way the shipping sidebar does.
                                horizontal-stretch: 1;
                                Text {
                                    text: item.label;
                                    width: 100%;
                                    font-family: Theme.body;
                                    color: Theme.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if !root.rail && item.badge != "" && item.badge != "NEW": VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Rectangle {
                                    border-radius: 9px;
                                    background: Theme.accent;
                                    height: 16px;
                                    horizontal-stretch: 0;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        alignment: center;
                                        Text {
                                            text: item.badge;
                                            font-family: Theme.body;
                                            font-size: 9px;
                                            font-weight: 600;
                                            color: Theme.on-accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            if !root.rail && item.badge == "NEW": VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Rectangle {
                                    border-radius: 4px;
                                    background: transparent;
                                    border-width: 1px;
                                    border-color: Theme.accent-soft;
                                    height: 14px;
                                    horizontal-stretch: 0;
                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        alignment: center;
                                        Text {
                                            text: "NEW";
                                            font-family: Theme.body;
                                            font-size: 8px;
                                            font-weight: 600;
                                            letter-spacing: 0.5px;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        // In the rail the update count becomes a dot badge at
                        // the item's top-right, like the media query does.
                        if root.rail && item.badge != "" && item.badge != "NEW": Rectangle {
                            x: parent.width - self.width - 2px;
                            y: 2px;
                            // Explicit width: a self.width binding would be
                            // solved before the layout sizes this overlay.
                            width: 16px;
                            height: 14px;
                            border-radius: 7px;
                            background: Theme.accent;
                            HorizontalLayout {
                                padding-left: 3px;
                                padding-right: 3px;
                                alignment: center;
                                Text {
                                    text: item.badge;
                                    font-family: Theme.body;
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: Theme.on-accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.current = item.id;
                                root.selected(item.id);
                            }
                        }
                    }
                }
            }
        }
        if !root.rail: Rectangle {
            height: 55px;
            Rectangle { y: 0; height: 1px; width: 100%; background: Theme.line; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        horizontal-stretch: 0;
                        border-radius: 14px;
                        background: Theme.accent-soft;
                        Text {
                            text: root.account-initial;
                            font-family: Theme.body;
                            color: Theme.accent;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.account-name;
                        font-family: Theme.body;
                        color: Theme.fg;
                        font-size: 12.5px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    Text {
                        text: root.account-host;
                        font-family: Theme.body;
                        color: Theme.muted;
                        font-size: 11px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
