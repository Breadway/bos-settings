import { Theme, PageTitle, Lede, GroupBox, SettingRow, PillButton, VectorIcon } from "theme.slint";

export struct QuickTile {
    id: string,
    title: string,
    detail: string,
    // SVG path commands for the glyph, from src/icons.rs.
    icon: string,
    on: bool,
    enabled: bool,
}

export struct AttentionRow {
    label: string,
    hint: string,
    action: string,
    primary: bool,
}

component Tile inherits Rectangle {
    in property <QuickTile> tile;
    callback clicked(string);
    min-width: 170px;
    min-height: 102px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    background: tile.on ? Theme.accent-soft : Theme.surface;
    border-width: 1px;
    border-color: tile.on ? Theme.accent-line : Theme.line;
    opacity: tile.enabled ? 1 : 0.7;
    VerticalLayout {
        // Same box as the shipping tile: 16px padding, 10px between the icon,
        // the label and the detail line.
        padding: 16px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            VectorIcon {
                icon-size: 21px;
                commands: tile.icon;
                tint: tile.on ? Theme.accent : Theme.fg;
            }
        }
        Text {
            text: tile.title;
            font-family: Theme.body;
            color: Theme.fg;
            font-size: 13.5px;
            horizontal-alignment: left;
        }
        Text {
            text: tile.detail;
            font-family: Theme.body;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: left;
        }
    }
    TouchArea { enabled: tile.enabled; clicked => { root.clicked(tile.id); } }
}

export component HomePage inherits VerticalLayout {
    in property <string> greeting;
    in property <string> lede;
    in property <[QuickTile]> tiles;
    in property <[AttentionRow]> attention;
    in property <string> battery-label;
    in property <string> battery-detail;
    in property <string> storage-detail;
    in property <float> storage-used;
    in property <string> status;
    callback tile-clicked(string);
    // The shipping view is a CSS box model: 26px page padding, a 1.1 line
    // height on the title, a 6px gap before the lede and 18px before the
    // content. The app.slint column supplies the outer padding.
    spacing: 0px;
    alignment: start;
    PageTitle { text: greeting; }
    Rectangle { height: 6px; }
    Lede { text: lede; }
    Rectangle { height: 20px; }

    GridLayout {
        spacing: 10px;
        min-width: 716px;
        for tile[index] in root.tiles: Tile {
            tile: tile;
            row: Math.floor(index / 4);
            col: Math.mod(index, 4);
            clicked(id) => { root.tile-clicked(id); }
        }
    }

    Rectangle { height: 14px; }

    GroupBox {
        title: "NEEDS YOUR ATTENTION";
        for row[index] in attention: SettingRow {
            label: row.label;
            hint: row.hint;
            first: index == 0;
            PillButton { text: row.action; primary: row.primary; }
        }
    }

    Rectangle { height: 14px; }

    if storage-detail != "": HorizontalLayout {
        spacing: 10px;
        if battery-label != "": Rectangle {
            width: (root.width - 10px) / 2;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Rectangle {
                        // The shipping summary draws a plain accent ring, not
                        // a progress arc.
                        width: 48px;
                        height: 48px;
                        border-radius: 24px;
                        border-width: 4px;
                        border-color: Theme.accent;
                        Text {
                            text: battery-label;
                            font-family: Theme.body;
                            color: Theme.fg;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: "Battery"; font-family: Theme.body; color: Theme.fg; font-size: 13.5px; horizontal-alignment: left; }
                    Text { text: battery-detail; font-family: Theme.body; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: left; }
                }
            }
        }
        Rectangle {
            width: (root.width - 10px) / 2;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 16px;
                padding-bottom: 17px;
                spacing: 0px;
                alignment: start;
                Text { text: "Storage"; font-family: Theme.body; color: Theme.fg; font-size: 13.5px; horizontal-alignment: left; }
                Text { text: storage-detail; font-family: Theme.body; color: Theme.muted; font-size: 12px; horizontal-alignment: left; }
                Rectangle { height: 7px; }
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        // The shipping app leaves <progress> at its default
                        // 10em width, so the bar only spans part of the card.
                        width: 160px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.track;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * min(1, max(0, root.storage-used));
                            height: 100%;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                }
            }
        }
    }

    if status != "": Text {
        text: status;
        font-family: Theme.body;
        color: Theme.faint;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: left;
    }
}
